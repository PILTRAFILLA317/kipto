{
  "type": "object",
  "properties": {
    "requestVersion": {
      "type": "integer",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "captureId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "type": "string",
      "enum": [
        "es",
        "en"
      ]
    },
    "userTimeZone": {
      "type": "string",
      "maxLength": 100,
      "minLength": 1
    },
    "importedAt": {
      "type": "string",
      "format": "date-time"
    },
    "knownDocumentContext": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "documentDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "dateSource": {
              "type": "string",
              "enum": [
                "userConfirmed",
                "documentExplicit"
              ]
            }
          },
          "required": [
            "documentDate",
            "dateSource"
          ],
          "additionalProperties": false
        }
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "text",
            "imagePages"
          ]
        },
        "textPages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string",
                "maxLength": 60000,
                "minLength": 1
              }
            },
            "required": [
              "page",
              "text"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "imagePages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "mimeType": {
                "type": "string",
                "enum": [
                  "image/jpeg",
                  "image/png",
                  "image/webp"
                ]
              },
              "base64": {
                "type": "string",
                "maxLength": 8388608,
                "minLength": 1
              }
            },
            "required": [
              "page",
              "mimeType",
              "base64"
            ],
            "additionalProperties": false
          },
          "maxItems": 10
        }
      },
      "required": [
        "type",
        "textPages",
        "imagePages"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "totalPagesKnown": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "analyzedPages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "maxItems": 10,
          "minItems": 1
        },
        "isPartial": {
          "type": "boolean"
        }
      },
      "required": [
        "totalPagesKnown",
        "analyzedPages",
        "isPartial"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requestVersion",
    "requestId",
    "captureId",
    "sourceId",
    "sourceRevision",
    "locale",
    "userTimeZone",
    "importedAt",
    "knownDocumentContext",
    "input",
    "coverage"
  ],
  "additionalProperties": false
}
